local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local WHITELIST_URL = "https://raw.githubusercontent.com/dezqpal/Boldtespayb-/refs/heads/main/Whitelists.lua.v4"

local Whitelist = {}

-- Load whitelist
local function loadWhitelist()
    local ok, src = pcall(function()
        return game:HttpGet(WHITELIST_URL)
    end)
    if not ok then
        return false, "WHITELIST_FETCH_FAILED"
    end

    local success, data = pcall(function()
        return loadstring(src)()
    end)
    if not success or type(data) ~= "table" then
        return false, "INVALID_WHITELIST_DATA"
    end

    Whitelist = data
    return true
end

-- Whitelist checker (supports array & dictionary)
local function isWhitelisted()
    local name = LocalPlayer.Name

    if Whitelist[name] == true then
        return true
    end

    for _, v in ipairs(Whitelist) do
        if v == name then
            return true
        end
    end

    return false
end

-- Safe spoof check (NO executor false flags)
local function detectSpoof()
    if type(LocalPlayer.Name) ~= "string" then
        return false
    end

    if LocalPlayer.UserId <= 0 then
        return false
    end

    return true
end

-- Init
local ok, reason = loadWhitelist()
if not ok then
    LocalPlayer:Kick(reason)
    return
end

if not detectSpoof() then
    LocalPlayer:Kick("Spoof detected.")
    return
end

if not isWhitelisted() then
    LocalPlayer:Kick("Not whitelisted KUMAG!😂.")
    return
end

-- Runtime check (fixed)
task.spawn(function()
    while task.wait(3) do
        local ok = detectSpoof()
        if not ok then
            LocalPlayer:Kick("Spoof detected (runtime).")
            break
        end
    end
end)


