local ss = Window:Tab("Farming", "rbxassetid://10723425539")

ss:Seperator("Farming")

local fastRebirth = false

ss:Toggle("Fast Rebirth", false, nil, function(state)
    fastRebirth = state
    if not state then return end

    task.spawn(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local Players = game:GetService("Players")
        local VirtualInputManager = game:GetService("VirtualInputManager")

        local player = Players.LocalPlayer

        -- ===== PET FUNCTIONS =====
        local function unequipAllPets()
            local petsFolder = player.petsFolder
            for _, folder in pairs(petsFolder:GetChildren()) do
                if folder:IsA("Folder") then
                    for _, pet in pairs(folder:GetChildren()) do
                        ReplicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", pet)
                    end
                end
            end
            task.wait(0.05)
        end

        local function equipPet(petName)
            unequipAllPets()
            for _, pet in pairs(player.petsFolder.Unique:GetChildren()) do
                if pet.Name == petName then
                    ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet)
                end
            end
        end

        -- ===== MACHINE FINDER =====
        local function findMachine(name)
            local machine = workspace.machinesFolder:FindFirstChild(name)
            if not machine then
                for _, folder in pairs(workspace:GetChildren()) do
                    if folder:IsA("Folder") and folder.Name:lower():find("machines") then
                        machine = folder:FindFirstChild(name)
                        if machine then break end
                    end
                end
            end
            return machine
        end

        -- ===== PRESS E =====
        local function pressE()
            VirtualInputManager:SendKeyEvent(true, "E", false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, "E", false, game)
        end

        -- ===== MAIN LOOP =====
        while fastRebirth do
            local rebirths = player.leaderstats.Rebirths.Value
            local requiredStrength = 10000 + (5000 * rebirths)

            -- Golden Rebirth reduction
            if player.ultimatesFolder:FindFirstChild("Golden Rebirth") then
                local level = player.ultimatesFolder["Golden Rebirth"].Value
                requiredStrength = math.floor(requiredStrength * (1 - (level * 0.1)))
            end

            -- ===== STRENGTH FARM (LOW LAG) =====
            equipPet("Swift Samurai")

            while fastRebirth and player.leaderstats.Strength.Value < requiredStrength do
                -- 🔥 15 reps per 0.1 seconds
                for i = 1, 35 do
                    player.muscleEvent:FireServer("rep")
                end
                task.wait(0.1)
            end

            if not fastRebirth then break end

            -- ===== REBIRTH PET =====
            equipPet("Tribal Overlord")

            -- ===== MACHINE USE =====
            local machine = findMachine("Jungle Bar Lift")
            if machine and machine:FindFirstChild("interactSeat") then
                player.Character.HumanoidRootPart.CFrame =
                    machine.interactSeat.CFrame * CFrame.new(0, 3, 0)

                repeat
                    task.wait(0.1)
                    pressE()
                until not fastRebirth or player.Character.Humanoid.Sit
            end

            -- ===== REBIRTH =====
            local before = player.leaderstats.Rebirths.Value
            repeat
                ReplicatedStorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest")
                task.wait(0.15)
            until not fastRebirth or player.leaderstats.Rebirths.Value > before

            task.wait(0.2)
        end
    end)
end)

local autoFastStrength = false

ss:Toggle("Ultimate Fast Strength", false, nil, function(state)
    autoFastStrength = state
    getgenv().isGrinding = state

    if not state then return end

    task.spawn(function()
        while autoFastStrength do
            -- Batch 100 loops into 1 server call, repeat 5 times = 500 loops
            for batch = 1, 5 do
                for i = 1, 60 do
                    -- Your internal "fast" loop
                    game:GetService("Players").LocalPlayer.muscleEvent:FireServer("rep")
                end
                -- Wait a little so server sees only 1 loop per batch
                task.wait(0.1) -- 5 batches × 0.2s = 1 second
            end
        end
    end)
end)

