-- Unlock AutoLift Gamepass
ss:Toggle("Unlock AutoLift Gamepass", false, "Unlock the AutoLift Game Pass for free", function(state)
    if state then
        local ok, gamepassFolder = pcall(function() return ReplicatedStorage:WaitForChild("gamepassIds", 2) end)
        if not ok or not gamepassFolder then
            warn("gamepassIds not found in ReplicatedStorage")
            return
        end
        local player = Players.LocalPlayer
        if not player then return end
        if not player:FindFirstChild("ownedGamepasses") then
            local folder = Instance.new("Folder")
            folder.Name = "ownedGamepasses"
            folder.Parent = player
        end
        for _, gamepass in pairs(gamepassFolder:GetChildren()) do
            local value = Instance.new("IntValue")
            value.Name = gamepass.Name
            value.Value = (gamepass.Value or 1)
            value.Parent = player.ownedGamepasses
        end
    end
end)

-- SEPARATOR
ss:Seperator("Auto Exercises")

-- Auto Exercises
local function setupAutoTool(name)
    ss:Toggle("Auto " .. name, false, "Automatically do " .. name, function(state)
        getgenv()["Auto" .. name:gsub("%s","")] = state
        task.spawn(function()
            while getgenv()["Auto" .. name:gsub("%s","")] do
                local pl = Players.LocalPlayer
                if pl and pl.Backpack then
                    local tool = pl.Backpack:FindFirstChild(name)
                    if tool and pl.Character and pl.Character:FindFirstChildOfClass("Humanoid") then
                        pcall(function() pl.Character.Humanoid:EquipTool(tool) end)
                    end
                    pcall(function() pl.muscleEvent:FireServer("rep") end)
                end
                task.wait(0.1)
            end
        end)
    end)
end

setupAutoTool("Weight")
setupAutoTool("Pushups")
setupAutoTool("Handstands")
setupAutoTool("Situps")
setupAutoTool("Punch")

-- Fast Tools
ss:Toggle("Fast Tools", false, "Accelerates all tools", function(state)
    getgenv().FastTools = state
    local defaultSpeeds = {
        { "Punch", "attackTime", state and 0 or 0.35 },
        { "Ground Slam", "attackTime", state and 0 or 6 },
        { "Stomp", "attackTime", state and 0 or 7 },
        { "Handstands", "repTime", state and 0 or 1 },
        { "Pushups", "repTime", state and 0 or 1 },
        { "Weight", "repTime", state and 0 or 1 },
        { "Situps", "repTime", state and 0 or 1 },
    }
    task.spawn(function()
        local pl = Players.LocalPlayer
        if not pl then return end
        local backpack = pl:WaitForChild("Backpack")
        for _, info in ipairs(defaultSpeeds) do
            local tool = backpack:FindFirstChild(info[1])
            if tool and tool:FindFirstChild(info[2]) then
                pcall(function() tool[info[2]].Value = info[3] end)
            end
            local equipped = pl.Character and pl.Character:FindFirstChild(info[1])
            if equipped and equipped:FindFirstChild(info[2]) then
                pcall(function() equipped[info[2]].Value = info[3] end)
            end
        end
    end)
end)

