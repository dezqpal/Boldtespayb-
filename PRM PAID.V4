local Main = Window:Tab("Main", "rbxassetid://6026568198")

Main:Seperator("Client Stats")

--// Labels
local TimeLabel   = Main:Label("Executer Time: 0d 0h 0m 0s")
local FPSLabel    = Main:Label("FPS : Calculating...")
local PingLabel   = Main:Label("Ping : Calculating...")
local SmoothLabel = Main:Label("Smoothness : Calculating...")

--// ================================
--// EXECUTOR TIMER (Starts at 0)
--// ================================
local startTime = os.clock()

task.spawn(function()
	while task.wait(1) do
		local elapsed = math.floor(os.clock() - startTime)

		local d = math.floor(elapsed / 86400)
		local h = math.floor((elapsed % 86400) / 3600)
		local m = math.floor((elapsed % 3600) / 60)
		local s = elapsed % 60

		TimeLabel:Set(
			string.format("Executer Time: %dd %dh %dm %ds", d, h, m, s)
		)
	end
end)

--// ================================
--// FPS
--// ================================
task.spawn(function()
	while task.wait(0.1) do
		local fps = math.floor(workspace:GetRealPhysicsFPS())
		FPSLabel:Set("FPS : " .. fps)
	end
end)

--// ================================
--// Ping
--// ================================
task.spawn(function()
	while task.wait(0.2) do
		local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
		PingLabel:Set("Ping : " .. ping)
	end
end)

--// ================================
--// Smoothness
--// ================================
task.spawn(function()
	while task.wait(0.3) do
		local fps = workspace:GetRealPhysicsFPS()
		local smooth

		if fps >= 55 then
			smooth = "Very Smooth 🟢"
		elseif fps >= 40 then
			smooth = "Smooth 🟡"
		elseif fps >= 25 then
			smooth = "Laggy 🟠"
		else
			smooth = "Very Laggy 🔴"
		end

		SmoothLabel:Set("Smoothness : " .. smooth)
	end
end)

