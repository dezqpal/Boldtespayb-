-- WALK ON WATER
--==============================
local parts = {}
local size = 2048
local startPos = Vector3.new(-2, -9.5, -2)

task.spawn(function()
	for x = -5, 5 do
		for z = -5, 5 do
			local p = Instance.new("Part")
			p.Size = Vector3.new(size, 1, size)
			p.Position = startPos + Vector3.new(x*size, 0, z*size)
			p.Anchored = true
			p.Transparency = 1
			p.CanCollide = true
			p.Parent = workspace
			table.insert(parts, p)
		end
	end
end)

Main:Toggle("Walk on Water", true, "Walk on water surface", function(state)
	for _, p in pairs(parts) do
		if p then
			p.CanCollide = state
		end
	end
end)

