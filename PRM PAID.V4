local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StatsService = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer

-- If you already have a Window variable from your UI setup, keep using it.
-- Otherwise replace `Window` below with your UI instance (for example `ui` returned from relzhub:Window(...))
local statsTab = Window:Tab("Status", "rbxassetid://10709773755")

-- Converted to use the new StatusBox API:
-- StatusBox(title, initialText) -> returns api with :Set(text), :Append(text), :Clear(), :GetText()
local statusBox = statsTab:StatusBox("Status", "Initializing stats monitor...\n")

-- Abbreviation helper: K, M, B, T, Qa, Qi
local function abbrev(num, decimals)
    decimals = decimals or 2
    local absn = math.abs(num)
    local sign = num < 0 and "-" or ""
    local function fmt(v)
        return string.format("%."..decimals.."f", v)
    end

    if absn >= 1e18 then
        return sign .. fmt(num / 1e18) .. "Qi"
    elseif absn >= 1e15 then
        return sign .. fmt(num / 1e15) .. "Qa"
    elseif absn >= 1e12 then
        return sign .. fmt(num / 1e12) .. "T"
    elseif absn >= 1e9 then
        return sign .. fmt(num / 1e9) .. "B"
    elseif absn >= 1e6 then
        return sign .. fmt(num / 1e6) .. "M"
    elseif absn >= 1e3 then
        return sign .. fmt(num / 1e3) .. "K"
    else
        return sign .. tostring(num)
    end
end

-- Format a main stat as "123456 (123.46K)"
local function formatStatDisplay(num)
    local raw = tostring(num)
    local ab = abbrev(num, 2)
    -- If abbrev returned exactly the raw (small numbers), avoid duplicate like "12 (12)"
    if ab == raw then
        return raw
    else
        return string.format("%s (%s)", raw, ab)
    end
end

-- Format rates (can be decimal), show two decimals and abbrev if large:
-- "123.45 (0.12K)" or "12.34" if small
local function formatRateDisplay(num)
    local n = tonumber(num) or 0
    local raw = string.format("%.2f", n)
    local ab = abbrev(n, 2)
    if ab == tostring(n) or ab == raw then
        return raw
    else
        return string.format("%s (%s)", raw, ab)
    end
end

local function GetStatObject(player, statName)
    if player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild(statName) then
        return player.leaderstats[statName]
    end
    if player:FindFirstChild(statName) then
        return player[statName]
    end
    for _, child in pairs(player:GetChildren()) do
        if child:IsA("Folder") and child:FindFirstChild(statName) then
            return child[statName]
        end
    end
    return nil
end

local function GetPing()
    local success, ping = pcall(function()
        return math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)
    return success and ping or 0
end

task.spawn(function()
    local strengthObj = GetStatObject(LocalPlayer, "Strength")
    local durabilityObj = GetStatObject(LocalPlayer, "Durability")
    local rebirthObj = GetStatObject(LocalPlayer, "Rebirths")

    while not strengthObj or not durabilityObj or not rebirthObj do
        strengthObj = GetStatObject(LocalPlayer, "Strength")
        durabilityObj = GetStatObject(LocalPlayer, "Durability")
        rebirthObj = GetStatObject(LocalPlayer, "Rebirths")
        task.wait(1)
    end

    local strengthStart = strengthObj.Value
    local durabilityStart = durabilityObj.Value
    local rebirthStart = rebirthObj.Value
    local startTime = os.time()

    while true do
        local elapsed = os.time() - startTime

        if elapsed > 0 then
            local strengthVal = strengthObj.Value
            local durabilityVal = durabilityObj.Value
            local rebirthVal = rebirthObj.Value
            local pingVal = GetPing()

            local strengthGain = strengthVal - strengthStart
            local durabilityGain = durabilityVal - durabilityStart
            local rebirthGain = rebirthVal - rebirthStart

            local perMin = elapsed / 60
            if perMin == 0 then perMin = 1 end

            local strengthPerMin = strengthGain / perMin
            local durabilityPerMin = durabilityGain / perMin
            local rebirthPerMin = rebirthGain / perMin

            local strengthPerHour = strengthPerMin * 60
            local durabilityPerHour = durabilityPerMin * 60
            local rebirthPerHour = rebirthPerMin * 60

            local strengthPerWeek = strengthPerHour * 24 * 7
            local durabilityPerWeek = durabilityPerHour * 24 * 7
            local rebirthPerWeek = rebirthPerHour * 24 * 7

            local strengthPerMonth = strengthPerHour * 24 * 30
            local durabilityPerMonth = durabilityPerHour * 24 * 30
            local rebirthPerMonth = rebirthPerHour * 24 * 30

            -- Build formatted strings using abbreviation helpers
            local strengthDisplay = formatStatDisplay(strengthVal)
            local durabilityDisplay = formatStatDisplay(durabilityVal)
            local rebirthDisplay = formatStatDisplay(rebirthVal)
            local pingDisplay = tostring(pingVal) .. " ms"

            local spm = formatRateDisplay(strengthPerMin)
            local sph = formatRateDisplay(strengthPerHour)
            local spw = formatRateDisplay(strengthPerWeek)
            local spmo = formatRateDisplay(strengthPerMonth)

            local dpm = formatRateDisplay(durabilityPerMin)
            local dph = formatRateDisplay(durabilityPerHour)
            local dpw = formatRateDisplay(durabilityPerWeek)
            local dpmo = formatRateDisplay(durabilityPerMonth)

            local rpm = formatRateDisplay(rebirthPerMin)
            local rph = formatRateDisplay(rebirthPerHour)
            local rpw = formatRateDisplay(rebirthPerWeek)
            local rpmo = formatRateDisplay(rebirthPerMonth)

            statusBox:Set(string.format(
                "Strength: %s\nDurability: %s\nRebirths: %s\nPing: %s\n\n" ..
                "Strength Gain:\n%s / Min\n%s / Hour\n%s / Week\n%s / Month\n\n" ..
                "Durability Gain:\n%s / Min\n%s / Hour\n%s / Week\n%s / Month\n\n" ..
                "Rebirth Gain:\n%s / Min\n%s / Hour\n%s / Week\n%s / Month\n\n" ..
                "Last Updated: %s\n",
                strengthDisplay,
                durabilityDisplay,
                rebirthDisplay,
                pingDisplay,
                spm, sph, spw, spmo,
                dpm, dph, dpw, dpmo,
                rpm, rph, rpw, rpmo,
                os.date("%X")
            ))
        end

        task.wait(0.1)
    end
end)

local player = game:GetService("Players").LocalPlayer
local leaderstats = player:WaitForChild("leaderstats")

-- This script expects `statsTab` to be a valid page API from your UI library.
-- It will create a StatusBox on `statsTab` and display session data inside it.

-- Format number with abbreviations
local function formatAbbreviated(num)
	if not num then return "0" end
	if num >= 1e18 then
		return string.format("%.2fQi", num / 1e18)
	elseif num >= 1e15 then
		return string.format("%.2fQa", num / 1e15)
	elseif num >= 1e12 then
		return string.format("%.2fT", num / 1e12)
	elseif num >= 1e9 then
		return string.format("%.2fB", num / 1e9)
	elseif num >= 1e6 then
		return string.format("%.2fM", num / 1e6)
	elseif num >= 1e3 then
		return string.format("%.2fK", num / 1e3)
	else
		return string.format("%.2f", num)
	end
end

-- Format time
local function formatTime(seconds)
	local d = math.floor(seconds / 86400)
	local h = math.floor((seconds % 86400) / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	return string.format("%dd %dh %dm %02ds", d, h, m, s)
end

-- Calculate per-hour and per-day rates
local function calculateRate(gain, elapsed)
	if elapsed <= 0 then return 0, 0 end
	return gain / (elapsed / 3600), gain / (elapsed / 86400)
end

-- Create a StatusBox for the session monitor (uses the new StatusBox API)
-- StatusBox(title, initialText) -> returns api with :Set(text), :Append(text), :Clear(), :GetText()
local sessionStatusBox = statsTab:StatusBox("Session Monitor", "Initializing session monitor...\n")

-- Tracking variables
local sessionStartTime = os.time()
local hasStartedTracking = false

local sessionStartStrength = 0
local sessionStartDurability = 0
local sessionStartRebirths = 0

-- Start tracking initial values (safe lookups)
local function startTracking()
	if not hasStartedTracking then
		sessionStartStrength = (leaderstats:FindFirstChild("Strength") and leaderstats.Strength.Value) or 0
		sessionStartDurability = (player:FindFirstChild("Durability") and player.Durability.Value) or 0
		sessionStartRebirths = (leaderstats:FindFirstChild("Rebirths") and leaderstats.Rebirths.Value) or 0
		sessionStartTime = os.time()
		hasStartedTracking = true
	end
end

-- Build and update the single StatusBox text each tick
local function updateSession()
	startTracking()

	local currentStrength = (leaderstats:FindFirstChild("Strength") and leaderstats.Strength.Value) or 0
	local currentDurability = (player:FindFirstChild("Durability") and player.Durability.Value) or 0
	local currentRebirths = (leaderstats:FindFirstChild("Rebirths") and leaderstats.Rebirths.Value) or 0

	local strengthGain = currentStrength - sessionStartStrength
	local durabilityGain = currentDurability - sessionStartDurability
	local rebirthsGain = currentRebirths - sessionStartRebirths

	local elapsed = os.time() - sessionStartTime

	local strengthHour, strengthDay = calculateRate(strengthGain, elapsed)
	local durabilityHour, durabilityDay = calculateRate(durabilityGain, elapsed)
	local rebirthHour, rebirthDay = calculateRate(rebirthsGain, elapsed)

	-- Compose single multi-line status text (previous label content moved here)
	local content = string.format(
		"Session Time: %s\n\n" ..
		"Rebirth Pace: %s / Hour | %s / Day\n" ..
		"Strength Pace: %s / Hour | %s / Day\n" ..
		"Durability Pace: %s / Hour | %s / Day\n\n" ..
		"Gained Stats:\n" ..
		"Strength: %s | Gained: %s\n" ..
		"Durability: %s | Gained: %s\n" ..
		"Rebirths: %s | Gained: %s\n\n" ..
		"Last Updated: %s",
		formatTime(elapsed),
		formatAbbreviated(rebirthHour), formatAbbreviated(rebirthDay),
		formatAbbreviated(strengthHour), formatAbbreviated(strengthDay),
		formatAbbreviated(durabilityHour), formatAbbreviated(durabilityDay),
		formatAbbreviated(currentStrength), formatAbbreviated(strengthGain),
		formatAbbreviated(currentDurability), formatAbbreviated(durabilityGain),
		formatAbbreviated(currentRebirths), formatAbbreviated(rebirthsGain),
		os.date("%c")
	)

	-- Update the StatusBox (replace entire content each update)
	pcall(function()
		sessionStatusBox:Set(content)
	end)
end

-- Update loop (once per second)
task.spawn(function()
	while true do
		updateSession()
		task.wait(0.1)
	end
end)

local teleportTab = Window:Tab("Teleport", "rbxassetid://10734886004")

local function TeleportPlayer(position, text)
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")
    hrp.CFrame = CFrame.new(position)

    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Teleporte",
        Text = text,
        Duration = 3
    })
end

